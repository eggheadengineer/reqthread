{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:evidence-bundle:schema:design-file:0.1.0",
  "title": "Design element file front matter (*.design.md)",
  "type": "object",
  "required": ["id"],
  "additionalProperties": false,
  "properties": {
    "id": { "$ref": "#/$defs/key" },
    "derives_from": { "$ref": "#/$defs/keys", "description": "Architecture element keys." },
    "satisfies": { "$ref": "#/$defs/keys", "description": "Requirement keys." }
  },
  "$defs": {
    "key": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*-[A-Z0-9][A-Z0-9._-]*$" },
    "keys": { "type": "array", "items": { "$ref": "#/$defs/key" }, "uniqueItems": true }
  }
}
