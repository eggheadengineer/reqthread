{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:evidence-bundle:schema:architecture-file:0.1.0",
  "title": "Architecture element file front matter (*.arch.md)",
  "type": "object",
  "required": ["id", "safety_related"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*-[A-Z0-9][A-Z0-9._-]*$" },
    "safety_related": { "type": "boolean" },
    "integrity_level": { "type": "string" }
  }
}
